{
  "name": "naukri-update",
  "version": "1.0.0",
  "description": "Keeps a Naukri profile fresh by toggling a trailing dot on the resume headline/summary",
  "main": "naukri-profile-refresh.js",
  "scripts": {
    "refresh": "node naukri-profile-refresh.js",
    "refresh:visible": "node naukri-profile-refresh.js visible",
    "login": "node login-all.js",
    "login:all": "node login-all.js",
    "login:naukri": "node login-all.js naukri",
    "login:internshala": "node login-all.js internshala",
    "login:linkedin": "node login-all.js linkedin",
    "login:indeed": "node login-all.js indeed",
    "login:wellfound": "node login-all.js wellfound",
    "login:foundit": "node login-all.js foundit",
    "apply": "node naukri-auto-apply.js",
    "apply:dry": "node naukri-auto-apply.js dry",
    "apply:visible": "node naukri-auto-apply.js visible",
    "apply:naukri": "node naukri-auto-apply.js",
    "apply:internshala": "node internshala-apply.js",
    "apply:linkedin": "node linkedin-apply.js",
    "apply:indeed": "node indeed-apply.js",
    "apply:wellfound": "node wellfound-apply.js",
    "apply:foundit": "node foundit-apply.js",
    "apply:all": "node apply-all.js",
    "apply:all:dry": "node apply-all.js dry",
    "apply:all:visible": "node apply-all.js visible",
    "apply:clean": "node -e \"const fs=require('fs'); fs.writeFileSync('./applied-jobs.json', JSON.stringify({applied:[], lastUpdated: new Date().toISOString()}, null, 2)); console.log('Cleaned applied-jobs.json');\"",
    "apply:history": "node -e \"const f=require('./applied-jobs.json'); console.table(f.applied.map(a=>({Title: (a.title||'').slice(0,28), Company: (a.company||'').slice(0,18), Portal: a.portal||'Naukri', Category: a.category, Resume: (a.resumeUsed||'').slice(0,22), Score: (a.matchScore||50)+'%', Status: a.status})))\"",
    "mail:report": "node mailer.js",
    "mail:preview": "node mailer.js preview",
    "task:status": "powershell -Command Get-ScheduledTask -TaskName NaukriProfileRefresh",
    "task:info": "powershell -Command Get-ScheduledTaskInfo -TaskName NaukriProfileRefresh",
    "task:start": "powershell -Command Start-ScheduledTask -TaskName NaukriProfileRefresh",
    "task:register": "powershell -ExecutionPolicy Bypass -File ./register-task.ps1",
    "task:mail:status": "powershell -Command Get-ScheduledTask -TaskName DailyApplicationReport",
    "task:mail:register": "powershell -ExecutionPolicy Bypass -File ./register-daily-mail.ps1",
    "status:check": "node status-tracker.js",
    "status:check:visible": "node status-tracker.js visible",
    "cold:mail": "node cold-mailer.js",
    "cold:mail:dry": "node cold-mailer.js dry",
    "s3:sync": "node -e \"require('./s3-storage').syncTailoredResumes()\"",
    "sync:ec2": "powershell -ExecutionPolicy Bypass -File ./transfer-data.ps1",
    "dashboard": "node dashboard-server.js",
    "start": "node dashboard-server.js"
  },
  "author": "Ankit Baghel",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "nodemailer": "^9.0.5",
    "playwright-core": "^1.61.1"
  }
}
