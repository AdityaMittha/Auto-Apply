# ============================================================
#  Auto-Apply config — copy this file to ".env" and fill it in.
#  The .env file is git-ignored, so your real data never gets pushed.
# ============================================================

# --- Google login (used by the Naukri profile-refresh auto-login) ---
GOOGLE_EMAIL=you@gmail.com
GOOGLE_PASSWORD=your-google-password

# --- Naukri ---
# Your Naukri profile page (the default works for every account; change only if Naukri changes its URL)
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile

# --- Identity / contact ---
NAME=Your Name
EMAIL=you@gmail.com
PHONE=+91 9999999999
LOCATION=City, Country

# --- Profile ---
CURRENT_ROLE=Your Title at YourCompany (City)
COMPANY=YourCompany
EDUCATION=Your Degree, Your Institute (2021-2025)
YEARS_EXPERIENCE=X years professional plus internships
SKILLS=JavaScript, TypeScript, Python, React, Node.js, FastAPI, MongoDB, PostgreSQL, Docker, GCP

# Up to 5 resume highlights, separated by ||
HIGHLIGHTS=First key achievement with impact/numbers||Second achievement||Third achievement||Fourth achievement||Fifth achievement

# --- Application answers ---
NOTICE_PERIOD=30 days
CURRENT_CTC=0
EXPECTED_CTC=0
DOB=DD/MM/YYYY
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence.

# --- Links ---
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# --- Optional: Gemini API key for AI-powered job analysis & screening answers ---
GEMINI_KEY=

# --- AI Configuration (all optional — defaults shown) ---
# Model to use (gemini-flash-latest is free tier, fast, and great for this use case)
GEMINI_MODEL=gemini-flash-latest
# Set to false to disable AI and use keyword-only matching
AI_ENABLED=true
# Timeout for each AI API call in milliseconds
AI_TIMEOUT_MS=10000

# --- Email Report Settings (End-of-Day Digest) ---
REPORT_EMAIL_TO=adityamittha09@gmail.com
SMTP_USER=adityamittha09@gmail.com
SMTP_PASS=your-gmail-app-password

# --- Auto Apply Settings ---
AUTO_APPLY_KEYWORDS=Embedded Systems Intern, Firmware Engineer, Python Developer, IoT Intern, Embedded C
AUTO_APPLY_LOCATIONS=Pune, Remote, Solapur
ALLOWED_LOCATIONS=Pune, Remote, Solapur, Work from Home, WFH, Anywhere
AUTO_APPLY_EXPERIENCE=0
AUTO_APPLY_MAX_PER_RUN=10
AUTO_APPLY_MIN_MATCH_SCORE=70
DRY_RUN=false

# --- Recruiter Cold Email Outreach ---
COLD_EMAIL_ENABLED=true
COLD_EMAIL_MAX_PER_DAY=10

# --- Amazon S3 Storage ---
S3_BUCKET_NAME=auto-apply-aditya-mittha
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

